  "memory": {
    "command": "yarn",
    "args": [
      "dlx",
      "@modelcontextprotocol/server-memory"
    ],
    "env": {}
  },
  "mermaid": {
    "command": "yarn",
    "args": [
      "dlx",
      "mcp-mermaid"
    ],
    "env": {}
  },
  "context7": {
    "command": "yarn",
    "args": [
      "dlx",
      "@upstash/context7-mcp"
    ],
    "env": {}
