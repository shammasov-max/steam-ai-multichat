{
  "mcpServers": {
    "filesystem": {

      "disabled": true,
      "type": "stdio",
      "command": "yarn",
      "args": [
        "dlx",
        "mcp-server-wsl-filesystem",

        "/mnt/x/a/dev"
      ],
      "env": {}
    }, 
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
