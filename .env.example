# MongoDB Configuration
# Connection string including authentication
MONGODB_URI=mongodb://localhost:27017
# Alternative: Full connection string with replica set and options
# MONGODB_URI=mongodb://username:password@host1:27017,host2:27017,host3:27017/database?replicaSet=myReplicaSet&authSource=admin

# Database name
MONGODB_DATABASE=effect-redux

# Collection names
MONGODB_EVENTS_COLLECTION=events
MONGODB_SNAPSHOTS_COLLECTION=snapshots
MONGODB_ACCOUNTS_COLLECTION=accounts
MONGODB_DIALOGS_COLLECTION=dialogs
MONGODB_SYSTEM_COLLECTION=system

# Connection pool settings
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Write settings
MONGODB_RETRY_WRITES=true

# Example for MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=production

# Example for local development with authentication
# MONGODB_URI=mongodb://admin:password@localhost:27017/?authSource=admin
# MONGODB_DATABASE=effect-redux-dev