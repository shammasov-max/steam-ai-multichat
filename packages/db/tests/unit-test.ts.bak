// Unit test for database package types and structure using Vitest
import { test, describe, expect } from 'vitest'
import { createDb } from '../src/index'
import { accountSlice, dialogSlice, systemSlice } from '@packages/isomorphic'

describe('DB Package Unit Tests', () => {
    test('should have createDb function that returns correct type', () => {
        const db = createDb('mongodb://localhost:27017/test')
        expect(db).toBeTruthy()
        expect(typeof db).toBe('object')
    })

    test('should have database instance with correct properties', () => {
        const db = createDb('mongodb://localhost:27017/test')
        
        expect(db.eventStore).toBeTruthy()
        expect(db.repos).toBeTruthy()
    })

    test('should create repositories for each slice', () => {
        const db = createDb('mongodb://localhost:27017/test')
        
        expect('account' in db.repos).toBe(true)
        expect('dialog' in db.repos).toBe(true)
        expect('system' in db.repos).toBe(true)
    })

    test('should have repository methods', () => {
        const db = createDb('mongodb://localhost:27017/test')
        const accountRepo = db.repos.account
        
        expect(typeof accountRepo.findById).toBe('function')
        expect(typeof accountRepo.findAll).toBe('function')
        expect(typeof accountRepo.save).toBe('function')
        expect(typeof accountRepo.delete).toBe('function')
    })

    test('should have event store methods', () => {
        const db = createDb('mongodb://localhost:27017/test')
        
        expect(typeof db.eventStore.append).toBe('function')
        expect(typeof db.eventStore.appendBatch).toBe('function')
        expect(typeof db.eventStore.getEvents).toBe('function')
    })

    test('should have slices with required properties', () => {
        expect(accountSlice.name).toBe('account')
        expect(accountSlice.schema).toBeTruthy()
        
        expect(dialogSlice.name).toBe('dialog')
        expect(dialogSlice.schema).toBeTruthy()
        
        expect(systemSlice.name).toBe('system')
        expect(systemSlice.schema).toBeTruthy()
    })

    test('should have schema annotations (runtime check)', () => {
        // Get the AST to check annotations
        const accountAST = (accountSlice.schema as any).ast || {}
        const dialogAST = (dialogSlice.schema as any).ast || {}
        const systemAST = (systemSlice.schema as any).ast || {}

        // These checks are more informational than strict requirements
        // since annotations might not be accessible at runtime
        if (accountAST.annotations?.indexes) {
            expect(accountAST.annotations.indexes).toBeTruthy()
        }
        
        if (dialogAST.annotations?.indexes) {
            expect(dialogAST.annotations.indexes).toBeTruthy()
        }
        
        if (systemAST.annotations?.indexes) {
            expect(systemAST.annotations.indexes).toBeTruthy()
        }
        
        // At minimum, we should have the AST structure
        expect(typeof accountAST).toBe('object')
        expect(typeof dialogAST).toBe('object')
        expect(typeof systemAST).toBe('object')
    })

    test('should have database methods', () => {
        const db = createDb('mongodb://localhost:27017/test')
        
        expect(typeof db.init).toBe('function')
        expect(typeof db.close).toBe('function')
        expect(typeof db.clearAll).toBe('function')
    })
})