import { Effect, Option } from 'effect'
import { test, describe, beforeAll, afterAll, beforeEach, expect } from 'vitest'
import { createDb, runWithMongoDB, MongoDB } from '../src/index.js'
import { createAccountId, createDialogId } from '../../isomorphic/src/index.js'
import type { Account, Dialog, System } from '../../isomorphic/src/index.js'
import { MongoClient } from 'mongodb'

// Test configuration
const TEST_CONNECTION_STRING = 'mongodb://localhost:27017/test_db'
const TEST_DB_NAME = 'test_db'
const TEST_CONFIG = {
    connectionString: TEST_CONNECTION_STRING,
    poolSize: 10,
    cache: {
        capacity: 1000,
        ttlMinutes: 30
    }
}

describe('Effect-Based MongoDB Database Package', () => {
    let mongoClient: MongoClient
    const { slices } = createDb(TEST_CONNECTION_STRING)

    beforeAll(async () => {
        // Create direct mongo client for verification
        mongoClient = new MongoClient(TEST_CONNECTION_STRING)
        await mongoClient.connect()
    })

    afterAll(async () => {
        await mongoClient.close()
    })

    beforeEach(async () => {
        // Clear all collections before each test
        const clearProgram = Effect.gen(function* () {
            const db = yield* MongoDB
            yield* db.clearAll()
        })
        
        await Effect.runPromise(
            runWithMongoDB(TEST_CONFIG, slices, clearProgram)
        )
    })

    describe('Database Initialization', () => {
        test('should connect to MongoDB successfully', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                expect(db).toBeTruthy()
                expect(db.eventStore).toBeTruthy()
                expect(db.repos).toBeTruthy()
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should create repositories for all slices', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                expect(db.repos.account).toBeTruthy()
                expect(db.repos.dialog).toBeTruthy()
                expect(db.repos.system).toBeTruthy()
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should extract database name from connection string', async () => {
            const testDb = mongoClient.db(TEST_DB_NAME)
            const collections = await testDb.listCollections().toArray()
            
            // Should have created collections
            const collectionNames = collections.map(c => c.name)
            expect(collectionNames).toContain('events')
        })
    })

    describe('Account Repository', () => {
        const testAccount: Account = {
            accountId: createAccountId('12345678901234567'),
            steamId64: '12345678901234567',
            proxyUrl: 'http://proxy.example.com',
            status: 'disconnected',
            label: 'Test Account'
        }

        test('should save and retrieve an account', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                yield* db.repos.account.save(testAccount)
                
                const retrieved = yield* db.repos.account.findById(testAccount.accountId)
                expect(Option.isSome(retrieved)).toBe(true)
                if (Option.isSome(retrieved)) {
                    expect(retrieved.value).toEqual(testAccount)
                }
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should find all accounts', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const account1 = { ...testAccount, accountId: createAccountId('11111111111111111') }
                const account2 = { ...testAccount, accountId: createAccountId('98765432109876543'), steamId64: '98765432109876543' }
                
                yield* db.repos.account.save(account1)
                yield* db.repos.account.save(account2)
                
                const all = yield* db.repos.account.findAll()
                expect(all).toHaveLength(2)
                expect(all.some(acc => acc.accountId === account1.accountId)).toBe(true)
                expect(all.some(acc => acc.accountId === account2.accountId)).toBe(true)
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should update an account', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                yield* db.repos.account.save(testAccount)
                
                const updated = { ...testAccount, status: 'connected' as const }
                yield* db.repos.account.save(updated)
                
                const retrieved = yield* db.repos.account.findById(testAccount.accountId)
                expect(Option.isSome(retrieved)).toBe(true)
                if (Option.isSome(retrieved)) {
                    expect(retrieved.value.status).toBe('connected')
                }
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should delete an account', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                yield* db.repos.account.save(testAccount)
                yield* db.repos.account.delete(testAccount.accountId)
                
                const retrieved = yield* db.repos.account.findById(testAccount.accountId)
                expect(Option.isNone(retrieved)).toBe(true)
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })
    })

    describe('Dialog Repository', () => {
        const testDialog: Dialog = {
            dialogId: createDialogId('account_12345678901234567', '98765432109876543'),
            accountId: createAccountId('12345678901234567'),
            playerSteamId64: '98765432109876543',
            status: 'active',
            language: 'en',
            goal: 'Test conversation',
            init: 'Initial prompt',
            messages: [],
            continuationScore: 1.0,
            trend: 'stable',
            issuesDetected: [],
            goalProgress: 0,
            tokensUsed: 0,
            totalMessages: 0
        }

        test('should save and retrieve a dialog', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                yield* db.repos.dialog.save(testDialog)
                
                const retrieved = yield* db.repos.dialog.findById(testDialog.dialogId)
                expect(Option.isSome(retrieved)).toBe(true)
                if (Option.isSome(retrieved)) {
                    expect(retrieved.value).toEqual(testDialog)
                }
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should handle dialog with messages', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const dialogWithMessages = {
                    ...testDialog,
                    messages: [
                        {
                            id: 'msg1',
                            from: 'player' as const,
                            text: 'Hello',
                            ts: Date.now()
                        },
                        {
                            id: 'msg2',
                            from: 'account' as const,
                            text: 'Hi there!',
                            ts: Date.now() + 1000
                        }
                    ],
                    totalMessages: 2
                }
                
                yield* db.repos.dialog.save(dialogWithMessages)
                
                const retrieved = yield* db.repos.dialog.findById(testDialog.dialogId)
                expect(Option.isSome(retrieved)).toBe(true)
                if (Option.isSome(retrieved)) {
                    expect(retrieved.value.messages).toHaveLength(2)
                    expect(retrieved.value.totalMessages).toBe(2)
                }
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })
    })

    describe('System Repository', () => {
        test('should retrieve singleton system entity', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const system = yield* db.repos.system.findById('system')
                
                // System should exist as it's initialized with singleton
                expect(Option.isSome(system)).toBe(true)
                if (Option.isSome(system)) {
                    expect(system.value.systemId).toBe('system')
                    expect(system.value.roundRobin).toBeTruthy()
                    expect(system.value.rateLimits).toBeTruthy()
                }
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should update system entity', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const systemOpt = yield* db.repos.system.findById('system')
                expect(Option.isSome(systemOpt)).toBe(true)
                
                if (Option.isSome(systemOpt)) {
                    const updated: System = {
                        ...systemOpt.value,
                        roundRobin: {
                            pointer: 5,
                            eligibleAccountIds: [createAccountId('11111111111111111'), createAccountId('22222222222222222')]
                        }
                    }
                    
                    yield* db.repos.system.save(updated)
                    
                    const retrieved = yield* db.repos.system.findById('system')
                    expect(Option.isSome(retrieved)).toBe(true)
                    if (Option.isSome(retrieved)) {
                        expect(retrieved.value.roundRobin.pointer).toBe(5)
                        expect(retrieved.value.roundRobin.eligibleAccountIds).toHaveLength(2)
                    }
                }
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })
    })

    describe('Event Store', () => {
        test('should append and retrieve events', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const event = {
                    id: 'evt1',
                    type: 'accounts/connected',
                    payload: { accountId: createAccountId('76561198000000001') },
                    meta: {
                        schemaVersion: '1.0',
                        id: 'test',
                        ts: Date.now(),
                        aggregate: 'account',
                        kind: 'event' as const
                    },
                    timestamp: Date.now()
                }
                
                yield* db.eventStore.append(event)
                
                const events = yield* db.eventStore.getEvents()
                expect(events).toHaveLength(1)
                expect(events[0].type).toBe('accounts/connected')
                expect(events[0].meta.aggregate).toBe('account')
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should append batch of events', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const events = Array.from({ length: 5 }, (_, i) => ({
                    id: `evt${i}`,
                    type: 'dialogs/messageReceived',
                    payload: { dialogId: createDialogId('account_123', '76561198000000001'), text: `Message ${i}` },
                    meta: {
                        schemaVersion: '1.0',
                        id: `msg${i}`,
                        ts: Date.now() + i * 1000,
                        aggregate: 'dialog',
                        kind: 'event' as const
                    },
                    timestamp: Date.now() + i * 1000
                }))
                
                yield* db.eventStore.appendBatch(events)
                
                const retrieved = yield* db.eventStore.getEvents()
                expect(retrieved).toHaveLength(5)
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should filter events by aggregate', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const accountEvent = {
                    id: 'evt1',
                    type: 'accounts/connected',
                    payload: {},
                    meta: {
                        schemaVersion: '1.0',
                        id: 'acc1',
                        ts: Date.now(),
                        aggregate: 'account',
                        kind: 'event' as const
                    },
                    timestamp: Date.now()
                }
                
                const dialogEvent = {
                    id: 'evt2',
                    type: 'dialogs/created',
                    payload: {},
                    meta: {
                        schemaVersion: '1.0',
                        id: 'dlg1',
                        ts: Date.now(),
                        aggregate: 'dialog',
                        kind: 'event' as const
                    },
                    timestamp: Date.now()
                }
                
                yield* db.eventStore.appendBatch([accountEvent, dialogEvent])
                
                const accountEvents = yield* db.eventStore.getEvents({ aggregate: 'account' })
                expect(accountEvents).toHaveLength(1)
                expect(accountEvents[0].type).toBe('accounts/connected')
                
                const dialogEvents = yield* db.eventStore.getEvents({ aggregate: 'dialog' })
                expect(dialogEvents).toHaveLength(1)
                expect(dialogEvents[0].type).toBe('dialogs/created')
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })

        test('should get events since timestamp', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                const now = Date.now()
                const oldEvent = {
                    id: 'old',
                    type: 'test/old',
                    payload: {},
                    meta: {
                        schemaVersion: '1.0',
                        id: 'old',
                        ts: now - 10000,
                        aggregate: 'test',
                        kind: 'event' as const
                    },
                    timestamp: now - 10000
                }
                
                const newEvent = {
                    id: 'new',
                    type: 'test/new',
                    payload: {},
                    meta: {
                        schemaVersion: '1.0',
                        id: 'new',
                        ts: now,
                        aggregate: 'test',
                        kind: 'event' as const
                    },
                    timestamp: now
                }
                
                yield* db.eventStore.appendBatch([oldEvent, newEvent])
                
                const recentEvents = yield* db.eventStore.getEvents({ fromTimestamp: now - 5000 })
                expect(recentEvents).toHaveLength(1)
                expect(recentEvents[0].type).toBe('test/new')
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })
    })

    describe('Index Creation', () => {
        test('should create indexes from schema annotations', async () => {
            // Initialize database to create indexes
            const program = Effect.gen(function* () {
                yield* MongoDB
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )

            const testDb = mongoClient.db(TEST_DB_NAME)
            
            // Check account indexes
            const accountIndexes = await testDb.collection('accounts').indexes()
            const accountIndexNames = accountIndexes.map(idx => Object.keys(idx.key || {})[0])
            expect(accountIndexNames).toContain('accountId')
            
            // Check dialog indexes  
            const dialogIndexes = await testDb.collection('dialogs').indexes()
            const dialogIndexNames = dialogIndexes.map(idx => Object.keys(idx.key || {})[0])
            expect(dialogIndexNames).toContain('dialogId')
            
            // Check event indexes
            const eventIndexes = await testDb.collection('events').indexes()
            const eventIndexKeys = eventIndexes.map(idx => Object.keys(idx.key || {}).join(','))
            expect(eventIndexKeys).toContain('meta.aggregate,meta.ts')
        })
    })

    describe('Clear All', () => {
        test('should clear all collections', async () => {
            const program = Effect.gen(function* () {
                const db = yield* MongoDB
                
                // Add some data
                yield* db.repos.account.save({
                    accountId: createAccountId('12345678901234567'),
                    steamId64: '12345678901234567',
                    proxyUrl: 'http://proxy.example.com',
                    status: 'connected'
                })
                
                yield* db.eventStore.append({
                    id: 'evt1',
                    type: 'test',
                    payload: {},
                    meta: {
                        schemaVersion: '1.0',
                        id: 'test',
                        ts: Date.now(),
                        aggregate: 'test',
                        kind: 'event' as const
                    },
                    timestamp: Date.now()
                })
                
                // Clear all
                yield* db.clearAll()
                
                // Verify everything is cleared
                const accounts = yield* db.repos.account.findAll()
                expect(accounts).toHaveLength(0)
                
                const events = yield* db.eventStore.getEvents()
                expect(events).toHaveLength(0)
            })

            await Effect.runPromise(
                runWithMongoDB(TEST_CONFIG, slices, program)
            )
        })
    })
})