{
  "version": "1.0.0",
  "description": "MCP Settings for Browser Automation with Playwright and Puppeteer",
  "servers": {
s
    "playwright": {
      "enabled": true,
      "priority": 1,
      "description": "Official Playwright MCP server for browser automation",
      "command": "node",
      "args": [
        "C:/Users/miram/AppData/Roaming/npm/node_modules/@playwright/mcp/dist/index.js"
      ],
      "capabilities": [
        "browser_launch",
        "page_navigation",
        "element_interaction",
        "screenshot",
        "pdf_generation",
        "network_interception",
        "cookie_management",
        "local_storage",
        "session_storage",
        "console_logging",
        "request_response_monitoring",
        "javascript_execution",
        "element_selection",
        "form_filling",
        "file_upload",
        "file_download",
        "keyboard_input",
        "mouse_actions",
        "touch_actions",
        "geolocation",
        "permissions",
        "authentication",
        "proxy_support",
        "mobile_emulation",
        "accessibility_testing",
        "performance_metrics",
        "coverage_reporting",
        "har_recording",
        "video_recording",
        "tracing"
      ],
      "config": {
        "browser": {
          "type": "chromium",
          "headless": false,
          "channel": "chrome",
          "devtools": false,
          "slowMo": 0,
          "timeout": 30000,
          "navigationTimeout": 30000,
          "actionTimeout": 30000,
          "loadTimeout": 30000
        },
        "viewport": {
          "width": 1280,
          "height": 720,
          "deviceScaleFactor": 1,
          "isMobile": false,
          "hasTouch": false
        },
        "context": {
          "ignoreHTTPSErrors": true,
          "javaScriptEnabled": true,
          "bypassCSP": false,
          "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36",
          "locale": "en-US",
          "timezoneId": "America/New_York",
          "geolocation": null,
          "permissions": [],
          "extraHTTPHeaders": {},
          "httpCredentials": null,
          "colorScheme": "light",
          "acceptDownloads": true,
          "recordVideo": {
            "enabled": false,
            "dir": "./videos",
            "size": {
              "width": 1280,
              "height": 720
            }
          },
          "recordHar": {
            "enabled": false,
            "path": "./har"
          }
        },
        "screenshots": {
          "path": "./screenshots",
          "fullPage": false,
          "type": "png",
          "quality": 90
        },
        "pdf": {
          "path": "./pdfs",
          "format": "A4",
          "printBackground": true,
          "margin": {
            "top": "1cm",
            "right": "1cm",
            "bottom": "1cm",
            "left": "1cm"
          }
        },
        "trace": {
          "enabled": false,
          "screenshots": true,
          "snapshots": true,
          "sources": true
        }
      }
    },
    "better-playwright": {
      "enabled": true,
      "priority": 2,
      "description": "Enhanced Playwright MCP with built-in HTTP server and additional features",
      "command": "node",
      "args": [
        "C:/Users/miram/AppData/Roaming/npm/node_modules/better-playwright-mcp/dist/index.js"
      ],
      "capabilities": [
        "http_server",
        "session_management",
        "parallel_execution",
        "test_generation",
        "visual_testing",
        "api_testing",
        "database_integration",
        "email_testing",
        "sms_testing",
        "webhook_testing",
        "graphql_testing",
        "websocket_testing",
        "grpc_testing",
        "oauth_flows",
        "saml_flows",
        "jwt_handling",
        "multi_browser_support",
        "cross_browser_testing",
        "responsive_testing",
        "accessibility_audit",
        "performance_audit",
        "seo_audit",
        "security_audit",
        "lighthouse_integration",
        "axe_integration",
        "percy_integration",
        "applitools_integration",
        "browserstack_integration",
        "saucelabs_integration",
        "lambdatest_integration"
      ],
      "config": {
        "server": {
          "enabled": true,
          "port": 8080,
          "host": "localhost",
          "cors": true,
          "auth": false
        },
        "browsers": [
          {
            "name": "chromium",
            "enabled": true,
            "options": {
              "headless": false,
              "channel": "chrome"
            }
          },
          {
            "name": "firefox",
            "enabled": true,
            "options": {
              "headless": false
            }
          },
          {
            "name": "webkit",
            "enabled": true,
            "options": {
              "headless": false
            }
          }
        ],
        "parallel": {
          "enabled": true,
          "workers": 4,
          "retries": 2,
          "timeout": 60000
        },
        "reporting": {
          "enabled": true,
          "formats": ["html", "json", "junit", "allure"],
          "outputDir": "./test-results"
        }
      }
    },
    "puppeteer": {
      "enabled": true,
      "priority": 3,
      "description": "Puppeteer MCP server for Chrome DevTools Protocol automation",
      "command": "node",
      "args": [
        "C:/Users/miram/AppData/Roaming/npm/node_modules/puppeteer-mcp-server/dist/index.js"
      ],
      "capabilities": [
        "chrome_devtools",
        "cdp_protocol",
        "performance_profiling",
        "memory_profiling",
        "cpu_profiling",
        "coverage_profiling",
        "runtime_evaluation",
        "debugger_api",
        "dom_snapshot",
        "css_coverage",
        "js_coverage",
        "network_throttling",
        "cpu_throttling",
        "offline_mode",
        "cache_disable",
        "service_worker_bypass",
        "request_interception",
        "response_modification",
        "websocket_frames",
        "webrtc_handling",
        "chrome_extensions",
        "user_data_dir",
        "chrome_flags",
        "stealth_mode",
        "fingerprint_evasion",
        "captcha_solving",
        "proxy_rotation",
        "session_persistence"
      ],
      "config": {
        "browser": {
          "product": "chrome",
          "headless": false,
          "devtools": false,
          "slowMo": 0,
          "timeout": 30000,
          "executablePath": "",
          "userDataDir": "",
          "args": [
            "--no-sandbox",
            "--disable-setuid-sandbox",
            "--disable-dev-shm-usage",
            "--disable-blink-features=AutomationControlled",
            "--disable-features=site-per-process",
            "--window-size=1280,720",
            "--start-maximized"
          ],
          "ignoreDefaultArgs": [
            "--enable-automation"
          ],
          "defaultViewport": {
            "width": 1280,
            "height": 720,
            "deviceScaleFactor": 1,
            "isMobile": false,
            "hasTouch": false,
            "isLandscape": true
          }
        },
        "stealth": {
          "enabled": true,
          "plugins": [
            "user-agent-override",
            "webgl.vendor",
            "window.outerdimensions",
            "navigator.plugins",
            "navigator.permissions",
            "navigator.webdriver",
            "navigator.languages",
            "iframe.contentWindow",
            "media.codecs"
          ]
        },
        "network": {
          "cacheEnabled": true,
          "setExtraHTTPHeaders": {},
          "setUserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
          "authenticate": null,
          "emulateNetworkConditions": null,
          "setOfflineMode": false,
          "setCookie": []
        }
      }
    }
  },
  "commands": {
    "browser:launch": {
      "description": "Launch a browser instance",
      "server": "playwright",
      "params": {
        "browser": "chromium|firefox|webkit",
        "headless": "boolean",
        "timeout": "number"
      }
    },
    "browser:close": {
      "description": "Close browser instance",
      "server": "playwright",
      "params": {}
    },
    "page:goto": {
      "description": "Navigate to URL",
      "server": "playwright",
      "params": {
        "url": "string",
        "waitUntil": "load|domcontentloaded|networkidle",
        "timeout": "number"
      }
    },
    "page:screenshot": {
      "description": "Take a screenshot",
      "server": "playwright",
      "params": {
        "path": "string",
        "fullPage": "boolean",
        "type": "png|jpeg",
        "quality": "number"
      }
    },
    "page:pdf": {
      "description": "Generate PDF",
      "server": "playwright",
      "params": {
        "path": "string",
        "format": "A4|Letter|Legal",
        "printBackground": "boolean"
      }
    },
    "element:click": {
      "description": "Click an element",
      "server": "playwright",
      "params": {
        "selector": "string",
        "button": "left|right|middle",
        "clickCount": "number",
        "delay": "number"
      }
    },
    "element:type": {
      "description": "Type text into element",
      "server": "playwright",
      "params": {
        "selector": "string",
        "text": "string",
        "delay": "number"
      }
    },
    "element:fill": {
      "description": "Fill form field",
      "server": "playwright",
      "params": {
        "selector": "string",
        "value": "string"
      }
    },
    "element:select": {
      "description": "Select option from dropdown",
      "server": "playwright",
      "params": {
        "selector": "string",
        "value": "string|array"
      }
    },
    "element:check": {
      "description": "Check checkbox or radio",
      "server": "playwright",
      "params": {
        "selector": "string"
      }
    },
    "element:uncheck": {
      "description": "Uncheck checkbox",
      "server": "playwright",
      "params": {
        "selector": "string"
      }
    },
    "element:hover": {
      "description": "Hover over element",
      "server": "playwright",
      "params": {
        "selector": "string"
      }
    },
    "element:focus": {
      "description": "Focus element",
      "server": "playwright",
      "params": {
        "selector": "string"
      }
    },
    "element:waitFor": {
      "description": "Wait for element",
      "server": "playwright",
      "params": {
        "selector": "string",
        "state": "visible|hidden|attached|detached",
        "timeout": "number"
      }
    },
    "evaluate:script": {
      "description": "Execute JavaScript in page context",
      "server": "playwright",
      "params": {
        "script": "string",
        "args": "array"
      }
    },
    "network:setHeaders": {
      "description": "Set extra HTTP headers",
      "server": "playwright",
      "params": {
        "headers": "object"
      }
    },
    "network:setCookies": {
      "description": "Set cookies",
      "server": "playwright",
      "params": {
        "cookies": "array"
      }
    },
    "network:clearCookies": {
      "description": "Clear cookies",
      "server": "playwright",
      "params": {}
    },
    "network:setOffline": {
      "description": "Set offline mode",
      "server": "playwright",
      "params": {
        "offline": "boolean"
      }
    },
    "network:emulate": {
      "description": "Emulate network conditions",
      "server": "playwright",
      "params": {
        "offline": "boolean",
        "downloadThroughput": "number",
        "uploadThroughput": "number",
        "latency": "number"
      }
    },
    "storage:localStorage": {
      "description": "Manage localStorage",
      "server": "playwright",
      "params": {
        "action": "get|set|remove|clear",
        "key": "string",
        "value": "string"
      }
    },
    "storage:sessionStorage": {
      "description": "Manage sessionStorage",
      "server": "playwright",
      "params": {
        "action": "get|set|remove|clear",
        "key": "string",
        "value": "string"
      }
    },
    "keyboard:press": {
      "description": "Press keyboard key",
      "server": "playwright",
      "params": {
        "key": "string",
        "delay": "number"
      }
    },
    "keyboard:type": {
      "description": "Type text",
      "server": "playwright",
      "params": {
        "text": "string",
        "delay": "number"
      }
    },
    "mouse:move": {
      "description": "Move mouse",
      "server": "playwright",
      "params": {
        "x": "number",
        "y": "number"
      }
    },
    "mouse:click": {
      "description": "Click mouse",
      "server": "playwright",
      "params": {
        "x": "number",
        "y": "number",
        "button": "left|right|middle",
        "clickCount": "number"
      }
    },
    "mouse:down": {
      "description": "Mouse down",
      "server": "playwright",
      "params": {
        "button": "left|right|middle"
      }
    },
    "mouse:up": {
      "description": "Mouse up",
      "server": "playwright",
      "params": {
        "button": "left|right|middle"
      }
    },
    "mouse:wheel": {
      "description": "Scroll mouse wheel",
      "server": "playwright",
      "params": {
        "deltaX": "number",
        "deltaY": "number"
      }
    },
    "test:generate": {
      "description": "Generate test code",
      "server": "better-playwright",
      "params": {
        "url": "string",
        "actions": "array",
        "language": "javascript|typescript|python|csharp|java"
      }
    },
    "test:record": {
      "description": "Record user actions",
      "server": "better-playwright",
      "params": {
        "start": "boolean",
        "stop": "boolean"
      }
    },
    "audit:accessibility": {
      "description": "Run accessibility audit",
      "server": "better-playwright",
      "params": {
        "url": "string",
        "standard": "WCAG2A|WCAG2AA|WCAG2AAA"
      }
    },
    "audit:performance": {
      "description": "Run performance audit",
      "server": "better-playwright",
      "params": {
        "url": "string",
        "metrics": "array"
      }
    },
    "audit:seo": {
      "description": "Run SEO audit",
      "server": "better-playwright",
      "params": {
        "url": "string"
      }
    },
    "cdp:execute": {
      "description": "Execute CDP command",
      "server": "puppeteer",
      "params": {
        "method": "string",
        "params": "object"
      }
    },
    "stealth:enable": {
      "description": "Enable stealth mode",
      "server": "puppeteer",
      "params": {
        "plugins": "array"
      }
    }
  },
  "agents": {
    "browser-automation": {
      "description": "Automate browser interactions and testing",
      "capabilities": [
        "web_scraping",
        "form_filling",
        "ui_testing",
        "e2e_testing",
        "visual_regression",
        "performance_testing",
        "accessibility_testing",
        "api_testing"
      ],
      "prompts": {
        "scrape_data": "Extract data from the webpage using appropriate selectors",
        "fill_form": "Fill out the form with the provided data",
        "test_ui": "Test the UI components for functionality",
        "test_e2e": "Perform end-to-end testing of the user flow",
        "test_visual": "Compare visual appearance against baseline",
        "test_performance": "Measure and analyze performance metrics",
        "test_accessibility": "Check for accessibility compliance",
        "test_api": "Test API endpoints and responses"
      }
    },
    "test-generator": {
      "description": "Generate test scripts from user actions",
      "capabilities": [
        "record_actions",
        "generate_code",
        "create_assertions",
        "handle_waits",
        "manage_data",
        "parameterize_tests"
      ],
      "prompts": {
        "record": "Record user interactions with the application",
        "generate": "Generate test code in the specified language",
        "assert": "Create assertions for the expected behavior",
        "wait": "Add appropriate wait conditions",
        "data": "Manage test data and fixtures",
        "parameterize": "Create data-driven tests"
      }
    },
    "web-inspector": {
      "description": "Inspect and analyze web pages",
      "capabilities": [
        "dom_inspection",
        "css_analysis",
        "js_debugging",
        "network_monitoring",
        "console_logging",
        "element_selection"
      ],
      "prompts": {
        "inspect_dom": "Analyze the DOM structure",
        "analyze_css": "Examine CSS styles and rules",
        "debug_js": "Debug JavaScript execution",
        "monitor_network": "Track network requests and responses",
        "view_console": "Display console logs and errors",
        "select_element": "Select and inspect specific elements"
      }
    }
  },
  "hooks": {
    "before_launch": {
      "enabled": true,
      "commands": [
        "echo 'Starting browser automation...'",
        "node -v",
        "npm list @playwright/mcp better-playwright-mcp puppeteer-mcp-server"
      ]
    },
    "after_launch": {
      "enabled": true,
      "commands": [
        "echo 'Browser launched successfully'"
      ]
    },
    "before_navigate": {
      "enabled": true,
      "commands": [
        "echo 'Navigating to: $URL'"
      ]
    },
    "after_navigate": {
      "enabled": true,
      "commands": [
        "echo 'Navigation completed'"
      ]
    },
    "on_error": {
      "enabled": true,
      "commands": [
        "echo 'Error occurred: $ERROR'",
        "node scripts/log-error.js '$ERROR'"
      ]
    },
    "on_screenshot": {
      "enabled": true,
      "commands": [
        "echo 'Screenshot saved: $PATH'"
      ]
    },
    "on_test_complete": {
      "enabled": true,
      "commands": [
        "echo 'Test completed: $TEST_NAME'",
        "echo 'Status: $STATUS'",
        "echo 'Duration: $DURATION'"
      ]
    }
  },
  "permissions": {
    "allow": [
      "browser:*",
      "page:*",
      "element:*",
      "network:*",
      "storage:*",
      "keyboard:*",
      "mouse:*",
      "evaluate:*",
      "test:*",
      "audit:*",
      "cdp:*",
      "stealth:*"
    ],
    "deny": [],
    "require_confirmation": [
      "evaluate:script",
      "cdp:execute",
      "network:setCookies",
      "storage:localStorage",
      "storage:sessionStorage"
    ]
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "file": "./logs/mcp-browser-automation.log",
    "console": true,
    "format": "json",
    "rotate": {
      "enabled": true,
      "maxSize": "10MB",
      "maxFiles": 10
    }
  },
  "performance": {
    "timeout": {
      "default": 30000,
      "navigation": 30000,
      "action": 10000,
      "script": 10000
    },
    "retry": {
      "enabled": true,
      "count": 3,
      "delay": 1000
    },
    "parallel": {
      "enabled": true,
      "maxWorkers": 4
    }
  }
}
